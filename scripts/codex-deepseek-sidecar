#!/usr/bin/env bash
set -euo pipefail

# Self-locate: derive sibling paths from $0 so the skill works from any
# directory name under ~/.codex/skills/ without hardcoded paths.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

usage() {
  cat <<'EOF'
Usage:
  codex-deepseek-sidecar [--profile NAME] [--effort high|max] [--cd DIR] [--task-id NAME] [--json] [--resume] [--session-id ID] [--pass-env NAME] [--no-monitor] [--verbose-stderr] [--no-doctor-check] PROMPT...
  codex-deepseek-sidecar [--profile NAME] [--effort high|max] [--cd DIR] [--task-id NAME] [--json] [--resume] [--session-id ID] [--pass-env NAME] [--no-monitor] [--verbose-stderr] [--no-doctor-check] -
  codex-deepseek-sidecar [--profile NAME] [--effort high|max] [--cd DIR] [--task-id NAME] [--session-id ID] --status
  codex-deepseek-sidecar [--profile NAME] [--effort high|max] [--cd DIR] [--task-id NAME] --list
  codex-deepseek-sidecar [--profile NAME] --configure

Runs Codex CLI as a DeepSeek-backed sidecar in a clean UTF-8 environment.
Execution opens a Terminal log monitor by default.
Without --resume or --session-id, starts a new persistent session and records the session ID.
With --resume, continues the most recent DeepSeek sidecar session in this working directory.
With --session-id <UUID>, resumes a specific session.
With --task-id NAME, records and looks up a named task within the working directory.
Use --status before follow-ups to report whether a recorded session is running or idle.
Use --list to show recorded sessions for the working directory.
Use --pass-env NAME repeatedly for task variables that the sidecar must inherit.
Use --effort high|max to override the profile's DeepSeek reasoning effort.
Use --no-monitor for non-interactive runs that should not open Terminal.
Use --verbose-stderr to display known harmless Codex startup warnings.
Use --no-doctor-check to skip the pre-flight connectivity check.
Use "-" to read the prompt from stdin.
EOF
}

workdir="${PWD}"
resume=0
json=0
verbose_stderr=0
status_only=0
list_only=0
monitor_enabled=1
profile="ds-sidecar-local"
profile_explicit=0
effort=""
effort_explicit=0
configure_only=0
doctor_check=1
session_id=""
task_id=""
pass_env=()
args=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --cd|-C)
      [[ $# -ge 2 ]] || { echo "missing value for $1" >&2; exit 2; }
      workdir="$2"
      shift 2
      ;;
    --profile|-p)
      [[ $# -ge 2 ]] || { echo "missing value for $1" >&2; exit 2; }
      profile="$2"; profile_explicit=1; shift 2 ;;
    --effort)
      [[ $# -ge 2 ]] || { echo "missing value for $1" >&2; exit 2; }
      effort="$2"; effort_explicit=1; shift 2 ;;
    --resume|-r)
      resume=1
      shift
      ;;
    --session-id)
      [[ $# -ge 2 ]] || { echo "missing value for $1" >&2; exit 2; }
      session_id="$2"
      shift 2
      ;;
    --task-id)
      [[ $# -ge 2 ]] || { echo "missing value for $1" >&2; exit 2; }
      task_id="$2"
      shift 2
      ;;
    --json)
      json=1
      shift
      ;;
    --pass-env)
      [[ $# -ge 2 ]] || { echo "missing value for $1" >&2; exit 2; }
      pass_env+=("$2")
      shift 2
      ;;
    --verbose-stderr)
      verbose_stderr=1
      shift
      ;;
    --no-monitor)
      monitor_enabled=0
      shift
      ;;
    --configure)
      configure_only=1; shift ;;
    --no-doctor-check)
      doctor_check=0; shift ;;
    --status)
      status_only=1
      shift
      ;;
    --list)
      list_only=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      args+=("$@")
      break
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done

if [[ "$status_only" -eq 1 && "$list_only" -eq 1 ]]; then
  echo "error: --status and --list cannot be used together" >&2
  exit 2
fi
if [[ ( "$status_only" -eq 1 || "$list_only" -eq 1 ) && ${#args[@]} -ne 0 ]]; then
  echo "error: --status and --list do not accept a prompt" >&2
  exit 2
fi
if [[ "$status_only" -eq 0 && "$list_only" -eq 0 && "$configure_only" -eq 0 && ${#args[@]} -eq 0 ]]; then
  usage >&2
  exit 2
fi
if [[ -n "$task_id" && ! "$task_id" =~ ^[A-Za-z0-9][A-Za-z0-9_.:-]*$ ]]; then
  echo "error: invalid task id: $task_id" >&2
  echo "  Use letters, numbers, dot, underscore, colon, or dash; start with a letter or number." >&2
  exit 2
fi
if [[ -n "$effort" && "$effort" != "high" && "$effort" != "max" ]]; then
  echo "error: --effort must be high or max" >&2
  exit 2
fi

# Helper: parse codex doctor JSON for critical check failures
parse_doctor() {
  python3 -c '
import os, sys, json
raw = sys.stdin.read()
start = raw.find("{")
if start < 0:
    raise ValueError("doctor output did not contain JSON")
d, _ = json.JSONDecoder().raw_decode(raw[start:])
checks = d.get("checks", {})
check_ids = [
    item.strip()
    for item in os.environ.get(
        "DOCTOR_REQUIRED_CHECKS",
        "config.load,installation,network.provider_reachability",
    ).split(",")
    if item.strip()
]
bad = []
for cid in check_ids:
    c = checks.get(cid, {})
    s = c.get("status", "?")
    if s != "ok":
        lines = ["[" + s + "] " + c.get("summary", cid)]
        details = c.get("details")
        if isinstance(details, dict):
            for k, v in sorted(details.items()):
                lines.append("  - " + str(k) + ": " + str(v))
        remediation = c.get("remediation")
        if remediation:
            lines.append("  remedy: " + str(remediation))
        bad.append("\n".join(lines))
if bad:
    print("\n\n".join(bad))
else:
    print("ok")
'
}

config_section_value() {
  local section="$1"
  local key="$2"
  [[ -f "$CONFIG_TOML" ]] || return 1
  python3 - "$CONFIG_TOML" "$section" "$key" <<'PY'
import re
import sys
path, section, key = sys.argv[1:4]
current = None
pattern = re.compile(r"^\s*\[" + re.escape(section) + r"\]\s*(?:#.*)?$")
next_section = re.compile(r"^\s*\[")
key_pattern = re.compile(r"^\s*" + re.escape(key) + r"\s*=\s*(.+?)\s*(?:#.*)?$")
try:
    lines = open(path, encoding="utf-8").read().splitlines()
except OSError:
    sys.exit(1)
for line in lines:
    if pattern.match(line):
        current = section
        continue
    if current and next_section.match(line):
        break
    if current:
        match = key_pattern.match(line)
        if match:
            value = match.group(1).strip()
            if len(value) >= 2 and value[0] == value[-1] and value[0] in ("'", "\""):
                value = value[1:-1]
            print(value)
            sys.exit(0)
sys.exit(1)
PY
}

profile_value() {
  local profile_path="$1"
  local key="$2"
  [[ -f "$profile_path" ]] || return 1
  python3 - "$profile_path" "$key" <<'PY'
import re
import sys

path, key = sys.argv[1:]
pattern = re.compile(r"^\s*" + re.escape(key) + r"\s*=\s*(.+?)\s*(?:#.*)?$")
try:
    lines = open(path, encoding="utf-8").read().splitlines()
except OSError:
    sys.exit(1)
for line in lines:
    match = pattern.match(line)
    if not match:
        continue
    value = match.group(1).strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in ("'", '\"'):
        value = value[1:-1]
    print(value)
    sys.exit(0)
sys.exit(1)
PY
}

profile_defaults() {
  case "$profile" in
    ds-sidecar-local) printf '%s\n' "ds-sidecar-local" "deepseek-v4-pro" "high" ;;
    ds-sidecar-flash) printf '%s\n' "ds-sidecar-local" "deepseek-v4-flash" "high" ;;
    ds-sidecar-beta) printf '%s\n' "ds-sidecar-beta" "deepseek-v4-pro" "high" ;;
    *) printf '%s\n' "$profile" "deepseek-v4-pro" "high" ;;
  esac
}

validate_sidecar_profile() {
  CONFIG_TOML="${HOME}/.codex/config.toml"
  PROFILE_TOML="${HOME}/.codex/${profile}.config.toml"
  [[ -f "$PROFILE_TOML" ]] || { echo "error: missing sidecar profile: $PROFILE_TOML" >&2; return 1; }
  profile_provider=$(profile_value "$PROFILE_TOML" "model_provider" 2>/dev/null || true)
  profile_model=$(profile_value "$PROFILE_TOML" "model" 2>/dev/null || true)
  profile_effort=$(profile_value "$PROFILE_TOML" "model_reasoning_effort" 2>/dev/null || true)
  [[ -n "$profile_provider" && -n "$profile_model" && -n "$profile_effort" ]] || {
    echo "error: profile must define model_provider, model, and model_reasoning_effort: $PROFILE_TOML" >&2
    return 1
  }
  if [[ "$profile_effort" != "high" && "$profile_effort" != "max" ]]; then
    echo "error: profile '$profile' must use DeepSeek reasoning effort high or max" >&2
    return 1
  fi
  provider_base_url=$(config_section_value "model_providers.${profile_provider}" "base_url" 2>/dev/null || true)
  provider_wire_api=$(config_section_value "model_providers.${profile_provider}" "wire_api" 2>/dev/null || true)
  if [[ "$provider_base_url" != http://127.0.0.1:12359/* || "$provider_wire_api" != "responses" ]]; then
    echo "error: profile '$profile' must use a local DeepSeek Responses provider on 127.0.0.1:12359" >&2
    return 1
  fi
}

ensure_local_proxy_running() {
  local health_url="$1"
  if curl -fsS --max-time 2 "$health_url" >/dev/null 2>&1; then
    return 0
  fi
  local label="${DEEPSEEK_SIDECAR_LAUNCHD_LABEL:-com.codex-deepseek-sidecar-proxy}"
  local service="gui/$(id -u)/${label}"
  /bin/launchctl kickstart -k "$service" >/dev/null 2>&1 || true
  for _ in 1 2 3 4 5; do
    if curl -fsS --max-time 2 "$health_url" >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done
  echo "error: DeepSeek sidecar proxy is unavailable; inspect launchctl print $service and the proxy log" >&2
  echo "  Set DEEPSEEK_SIDECAR_LAUNCHD_LABEL if your LaunchAgent uses another label." >&2
  return 1
}

check_sidecar_ready() {
  local ready_url="$1"
  local expected_model="$2"
  local ready_payload
  ready_payload=$(curl -fsS --max-time 10 "$ready_url" 2>/dev/null || true)
  if [[ -z "$ready_payload" ]]; then
    echo "error: DeepSeek sidecar cannot authenticate/reach the official API at $ready_url" >&2
    return 1
  fi
  if ! printf '%s' "$ready_payload" | python3 -c '
import json
import sys

expected = sys.argv[1]
payload = json.load(sys.stdin)
if payload.get("status") != "ok" or expected not in payload.get("models", []):
    raise SystemExit(1)
' "$expected_model"
  then
    echo "error: DeepSeek sidecar readiness check did not confirm model '$expected_model'" >&2
    return 1
  fi
}

refresh_model_catalog() {
  local catalog_builder="$SCRIPT_DIR/refresh-codex-model-catalog"
  local catalog_path="${HOME}/.codex/models.ds-sidecar.json"
  if [[ ! -x "$catalog_builder" ]]; then
    echo "error: sidecar model catalog refresher is not executable: $catalog_builder" >&2
    return 1
  fi
  "$catalog_builder" --output "$catalog_path" >/dev/null
}

# ── configure mode

if [[ "$configure_only" -eq 1 ]]; then
  [[ ${#args[@]} -eq 0 ]] || { echo "error: --configure does not accept a prompt" >&2; exit 2; }
  CONFIG_TOML="${HOME}/.codex/config.toml"
  if command -v codex &>/dev/null; then
    CODEX_DOCTOR_BIN="$(command -v codex)"
  elif [[ -x /Applications/ChatGPT.app/Contents/Resources/codex ]]; then
    CODEX_DOCTOR_BIN="/Applications/ChatGPT.app/Contents/Resources/codex"
  elif [[ -x /Applications/Codex.app/Contents/Resources/codex ]]; then
    CODEX_DOCTOR_BIN="/Applications/Codex.app/Contents/Resources/codex"
  else
    echo "error: codex not found in PATH, ChatGPT.app, or Codex.app" >&2
    exit 1
  fi
  if [[ -f "$CONFIG_TOML" ]]; then
    preflight_doctor_out=$("$CODEX_DOCTOR_BIN" doctor --json --summary 2>&1) || true
    preflight_result=$(printf '%s' "$preflight_doctor_out" | DOCTOR_REQUIRED_CHECKS="config.load" parse_doctor 2>/dev/null) || preflight_result="parse_error"
    if [[ "$preflight_result" != "ok" ]]; then
      echo "error: existing Codex config could not be loaded; not modifying $CONFIG_TOML" >&2
      if [[ "$preflight_result" == "parse_error" ]]; then
        printf '%s\n' "$preflight_doctor_out" >&2
      else
        printf '%s\n' "$preflight_result" >&2
      fi
      echo "" >&2
      echo "Fix the existing config first, then rerun:" >&2
      echo "  \"$CODEX_DOCTOR_BIN\" doctor --json --summary" >&2
      exit 1
    fi
  fi
  defaults=()
  while IFS= read -r default; do
    defaults+=("$default")
  done < <(profile_defaults)
  provider_name="${defaults[0]}"
  provider_exists=0
  PROFILE_TOML="${HOME}/.codex/${profile}.config.toml"
  profile_exists=0
  [[ -f "$PROFILE_TOML" ]] && profile_exists=1
  [[ -f "$CONFIG_TOML" ]] && grep -q "^\[model_providers\.${provider_name}\]" "$CONFIG_TOML" 2>/dev/null && provider_exists=1

  if [[ "$profile_exists" -eq 1 ]]; then
    echo "Profile config ${PROFILE_TOML} already exists."
  else
    echo "Profile config ${PROFILE_TOML} not found."
    mkdir -p "$(dirname "$PROFILE_TOML")"
    {
      echo "model_provider = \"${defaults[0]}\""
      echo "model = \"${defaults[1]}\""
      echo "model_reasoning_effort = \"${defaults[2]}\""
      echo 'model_context_window = 1048576'
      echo 'model_auto_compact_token_limit = 600000'
      echo "model_catalog_json = \"${HOME}/.codex/models.ds-sidecar.json\""
    } > "$PROFILE_TOML"
    echo "Wrote ${PROFILE_TOML}."
  fi

  if [[ "$provider_exists" -eq 1 ]]; then
    echo "Provider [model_providers.${provider_name}] already exists."
    existing_base_url=$(config_section_value "model_providers.${provider_name}" "base_url" 2>/dev/null || true)
    existing_provider_name=$(config_section_value "model_providers.${provider_name}" "name" 2>/dev/null || true)
    if [[ -n "$existing_provider_name" ]]; then
      echo "Existing provider name: $existing_provider_name"
    fi
    if [[ -n "$existing_base_url" ]]; then
      echo "Existing provider base_url: $existing_base_url"
      if [[ "$existing_base_url" == "http://127.0.0.1:12359/v1" || "$existing_base_url" == "http://127.0.0.1:12359/beta/v1" ]]; then
        echo "Existing provider already points at the built-in local proxy."
      else
        echo "Leaving the existing provider unchanged."
        echo "If this is a VibeAround or other provider profile, start that provider before using this sidecar."
        echo "To create a separate built-in-proxy profile, run:"
        echo "  $0 --profile ds-sidecar-local --configure"
      fi
    fi
  else
    mkdir -p "$(dirname "$CONFIG_TOML")"
    {
      echo ""
      echo "[model_providers.${provider_name}]"
      echo 'name = "DeepSeek via codex-deepseek-sidecar"'
      echo 'base_url = "http://127.0.0.1:12359/v1"'
      echo 'wire_api = "responses"'
      echo 'supports_websockets = false'
    } >> "$CONFIG_TOML"
    echo "Wrote [model_providers.${profile}] to config.toml."
    echo ""
  fi
  refresh_model_catalog
  echo "Checking sidecar profile and official API readiness..."
  validate_sidecar_profile
  ensure_local_proxy_running "${provider_base_url%/}/health"
  check_sidecar_ready "${provider_base_url%/}/ready" "$profile_model"
  echo "Sidecar profile and readiness check passed."
  exit 0
fi

# Codex's extension-host tool bridge expects UTF-8 environment strings. Build
# its environment from safe literals so unrelated desktop variables containing
# malformed bytes cannot panic tool execution.
safe_user="${USER:-$(/usr/bin/id -un)}"
safe_home="${HOME:-/Users/$safe_user}"

clean_env=(
  /usr/bin/env -i
  "HOME=$safe_home"
  "USER=$safe_user"
  "LOGNAME=$safe_user"
  "PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
  "SHELL=/bin/zsh"
  "TERM=xterm-256color"
  "LANG=en_US.UTF-8"
  "LC_ALL=en_US.UTF-8"
  "TMPDIR=/tmp/"
  "CODEX_HOME=${HOME}/.codex"
)

if [[ ${#pass_env[@]} -gt 0 ]]; then
  for env_name in "${pass_env[@]}"; do
    if [[ ! "$env_name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
      echo "error: invalid environment variable name for --pass-env: $env_name" >&2
      exit 2
    fi
    if [[ -z "${!env_name+x}" ]]; then
      echo "error: --pass-env variable is not set: $env_name" >&2
      exit 2
    fi
    if ! printf '%s' "${!env_name}" | /usr/bin/iconv -f UTF-8 -t UTF-8 >/dev/null 2>&1; then
      echo "error: --pass-env value is not valid UTF-8: $env_name" >&2
      exit 2
    fi
    clean_env+=("$env_name=${!env_name}")
  done
fi

STATE_ROOT="${XDG_STATE_HOME:-${HOME}/.codex/state}/deepseek-sidecar"
SESSION_FILE="$STATE_ROOT/sessions.txt"
LOCK_ROOT="$STATE_ROOT/locks"
LEGACY_SESSION_FILE="/tmp/deepseek-sidecar-sessions.txt"
umask 077
mkdir -p "$LOCK_ROOT"
chmod 700 "$STATE_ROOT" "$LOCK_ROOT"
if [[ ! -f "$SESSION_FILE" && -f "$LEGACY_SESSION_FILE" ]]; then
  cp "$LEGACY_SESSION_FILE" "$SESSION_FILE"
fi
touch "$SESSION_FILE"
chmod 600 "$SESSION_FILE"

extract_session_id() {
  sed -E 's/.* session_id=([^ ]+).*/\1/'
}

extract_workdir() {
  local line="$1"
  line="${line#workdir=}"
  if [[ "$line" == *" task_id="* ]]; then
    printf '%s' "${line%% task_id=*}"
  else
    printf '%s' "${line%% session_id=*}"
  fi
}

extract_task_id() {
  local line="$1"
  if [[ "$line" == *" task_id="* ]]; then
    line="${line#* task_id=}"
    line="${line%% profile=*}"
    printf '%s' "${line%% session_id=*}"
  else
    printf '%s' "-"
  fi
}

extract_profile() {
  local line="$1"
  if [[ "$line" == *" profile="* ]]; then
    line="${line#* profile=}"
    line="${line%% effort=*}"
    printf '%s' "${line%% session_id=*}"
  else
    printf '%s' ""
  fi
}

extract_effort() {
  local line="$1"
  if [[ "$line" == *" effort="* ]]; then
    line="${line#* effort=}"
    printf '%s' "${line%% session_id=*}"
  else
    printf '%s' ""
  fi
}

latest_session_line() {
  [[ -f "$SESSION_FILE" ]] || return 0
  if [[ -n "$task_id" ]]; then
    grep -F "workdir=${workdir} task_id=${task_id} " "$SESSION_FILE" 2>/dev/null | tail -1 || true
  else
    grep -F "workdir=${workdir} " "$SESSION_FILE" 2>/dev/null | tail -1 || true
  fi
}

session_is_running_by_id() {
  local sid="$1"
  local pid=""
  local dir="$LOCK_ROOT/$sid.lock"
  [[ -d "$dir" ]] || return 1
  [[ -f "$dir/pid" ]] && pid=$(cat "$dir/pid" 2>/dev/null || true)
  [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null
}

if [[ "$list_only" -eq 1 ]]; then
  found=0
  if [[ -f "$SESSION_FILE" ]]; then
    while IFS= read -r line; do
      [[ -n "$line" ]] || continue
      listed_workdir=$(extract_workdir "$line")
      listed_task_id=$(extract_task_id "$line")
      listed_profile=$(extract_profile "$line")
      listed_effort=$(extract_effort "$line")
      listed_session_id=$(printf '%s' "$line" | extract_session_id)
      [[ "$listed_workdir" == "$workdir" ]] || continue
      [[ -z "$task_id" || "$listed_task_id" == "$task_id" ]] || continue
      if session_is_running_by_id "$listed_session_id"; then
        listed_status="running"
      else
        listed_status="idle"
      fi
      echo "status=$listed_status task_id=$listed_task_id profile=${listed_profile:-unknown} effort=${listed_effort:-profile-default} session_id=$listed_session_id workdir=$listed_workdir"
      found=1
    done < "$SESSION_FILE"
  fi
  if [[ "$found" -eq 0 ]]; then
    if [[ -n "$task_id" ]]; then
      echo "status=missing task_id=$task_id workdir=$workdir"
    else
      echo "status=missing workdir=$workdir"
    fi
  fi
  exit 0
fi

if [[ ( "$resume" -eq 1 || "$status_only" -eq 1 ) && -z "$session_id" ]]; then
  if [[ -f "$SESSION_FILE" ]]; then
    session_line=$(latest_session_line)
    if [[ -n "$session_line" ]]; then
      session_id=$(printf '%s' "$session_line" | extract_session_id)
    fi
  fi
  if [[ "$resume" -eq 1 && -z "$session_id" ]]; then
    if [[ -n "$task_id" ]]; then
      echo "error: no previous DeepSeek sidecar session found for workdir=${workdir} task_id=${task_id}" >&2
    else
      echo "error: no previous DeepSeek sidecar session found for workdir=${workdir}" >&2
    fi
    echo "  Run without --resume first to start a new session." >&2
    exit 2
  fi
fi

if [[ "$resume" -eq 0 && "$status_only" -eq 0 && -z "$session_id" && -n "$task_id" ]]; then
  existing_line=$(latest_session_line)
  if [[ -n "$existing_line" ]]; then
    existing_session_id=$(printf '%s' "$existing_line" | extract_session_id)
    echo "error: task id already has a DeepSeek sidecar session: task_id=${task_id} session_id=${existing_session_id} workdir=${workdir}" >&2
    echo "  Use --resume --task-id ${task_id}, --session-id ${existing_session_id}, or choose a new --task-id." >&2
    exit 2
  fi
fi

if [[ -n "$session_id" && ! "$session_id" =~ ^[0-9A-Fa-f-]+$ ]]; then
  echo "error: invalid session id: $session_id" >&2
  exit 2
fi

session_workdir=""
session_task_id="-"
session_profile=""
session_effort=""
if [[ -n "$session_id" && -f "$SESSION_FILE" ]]; then
  session_line=$(grep -F "session_id=${session_id}" "$SESSION_FILE" 2>/dev/null | tail -1 || true)
  if [[ -n "$session_line" ]]; then
    session_workdir=$(extract_workdir "$session_line")
    session_task_id=$(extract_task_id "$session_line")
    session_profile=$(extract_profile "$session_line")
    session_effort=$(extract_effort "$session_line")
  fi
fi
if [[ -n "$session_id" && "$profile_explicit" -eq 0 && -n "$session_profile" ]]; then
  profile="$session_profile"
fi
if [[ -n "$session_id" && "$effort_explicit" -eq 0 && -n "$session_effort" ]]; then
  # Older mappings used the display-only string "profile-default". Let the
  # current profile supply its real setting instead of passing that string to
  # Codex as an invalid override.
  [[ "$session_effort" == "profile-default" ]] || effort="$session_effort"
fi

lock_dir=""
if [[ -n "$session_id" ]]; then
  lock_dir="$LOCK_ROOT/$session_id.lock"
fi

session_is_running() {
  local pid=""
  [[ -n "$lock_dir" && -d "$lock_dir" ]] || return 1
  [[ -f "$lock_dir/pid" ]] && pid=$(cat "$lock_dir/pid" 2>/dev/null || true)
  [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null
}

remove_stale_lock() {
  [[ -n "$lock_dir" && -d "$lock_dir" ]] || return 0
  rm -f "$lock_dir/pid"
  rmdir "$lock_dir" 2>/dev/null || true
}

if [[ "$status_only" -eq 1 ]]; then
  if [[ -z "$session_id" ]]; then
    if [[ -n "$task_id" ]]; then
      echo "status=missing task_id=$task_id workdir=$workdir next=new-session"
    else
      echo "status=missing workdir=$workdir next=new-session"
    fi
  elif session_is_running; then
    echo "status=running task_id=$session_task_id profile=${session_profile:-$profile} effort=${session_effort:-profile-default} session_id=$session_id workdir=${session_workdir:-unknown} next=wait"
  elif [[ -z "$session_workdir" ]]; then
    remove_stale_lock
    echo "status=untracked task_id=$session_task_id session_id=$session_id workdir=unknown next=resume-with---cd-or-new-session"
  else
    remove_stale_lock
    echo "status=idle task_id=$session_task_id profile=${session_profile:-$profile} effort=${session_effort:-profile-default} session_id=$session_id workdir=$session_workdir next=resume"
  fi
  exit 0
fi

# Locate Codex only for execution. CODEX_SUBAGENT_CODEX_BIN makes wrapper
# behavior testable without spending a model request.
if [[ -n "${CODEX_SUBAGENT_CODEX_BIN:-}" ]]; then
  CODEX_BIN="$CODEX_SUBAGENT_CODEX_BIN"
elif command -v codex &>/dev/null; then
  CODEX_BIN="$(command -v codex)"
elif [[ -x /Applications/ChatGPT.app/Contents/Resources/codex ]]; then
  # Terminal launched by AppleScript is a login shell with a minimal PATH.
  # ChatGPT.app is the installed desktop host on current macOS builds.
  CODEX_BIN="/Applications/ChatGPT.app/Contents/Resources/codex"
elif [[ -x /Applications/Codex.app/Contents/Resources/codex ]]; then
  CODEX_BIN="/Applications/Codex.app/Contents/Resources/codex"
elif [[ -x "${HOME}/.local/bin/codex" ]]; then
  CODEX_BIN="${HOME}/.local/bin/codex"
else
  echo "error: could not find codex binary" >&2
  exit 1
fi
if [[ ! -x "$CODEX_BIN" ]]; then
  echo "error: codex binary is not executable: $CODEX_BIN" >&2
  exit 1
fi

# ── profile and service pre-flight

validate_sidecar_profile
if [[ "$doctor_check" -eq 1 ]]; then
  ensure_local_proxy_running "${provider_base_url%/}/health"
  check_sidecar_ready "${provider_base_url%/}/ready" "$profile_model"
fi

run_workdir="$workdir"
effective_effort="${effort:-$profile_effort}"
effort_override=(-c "model_reasoning_effort=\"$effective_effort\"")
if [[ -n "$session_id" ]]; then
  if [[ -n "$session_workdir" ]]; then
    run_workdir="$session_workdir"
  fi
  if [[ ! -d "$run_workdir" ]]; then
    echo "error: session working directory does not exist: $run_workdir" >&2
    exit 2
  fi
  if session_is_running; then
    echo "error: session is already running: $session_id; use --status and wait before resuming" >&2
    exit 3
  fi
  remove_stale_lock
  if ! mkdir "$lock_dir" 2>/dev/null; then
    echo "error: could not lock session: $session_id" >&2
    exit 3
  fi
  echo "$$" > "$lock_dir/pid"
  cmd=(
    "$CODEX_BIN"
    exec
    --profile "$profile"
    --skip-git-repo-check
    --sandbox danger-full-access
    -c mcp_servers.vibearound.enabled=false
    "${effort_override[@]}"
    resume
    "$session_id"
  )
else
  cmd=(
    "$CODEX_BIN"
    exec
    --profile "$profile"
    --skip-git-repo-check
    --sandbox danger-full-access
    -c mcp_servers.vibearound.enabled=false
    "${effort_override[@]}"
    -C "$workdir"
  )
fi
if [[ ! -d "$run_workdir" ]]; then
  echo "error: working directory does not exist: $run_workdir" >&2
  exit 2
fi
if [[ "$json" -eq 1 ]]; then
  cmd+=(--json)
fi

tmp_dir=$(mktemp -d /tmp/deepseek-sidecar.XXXXXX)
tmp_stderr="$tmp_dir/stderr"
stderr_pipe="$tmp_dir/stderr.pipe"
mkfifo "$stderr_pipe"
monitor_log=""
monitor_done=""
monitor_session=""
stderr_pid=""

write_visible_output() {
  if [[ "$monitor_enabled" -eq 1 ]]; then
    tee -a "$monitor_log"
  else
    cat
  fi
}

filter_stderr() {
  if [[ "$verbose_stderr" -eq 1 ]]; then
    cat
  else
    sed -E \
      -e '/WARN codex_protocol::openai_models: Model personality requested but model_messages is missing, falling back to base instructions\./d' \
      -e '/WARN codex_core_skills::loader: ignoring interface\.icon_(small|large): icon path must not contain/d'
  fi
}

if [[ "$monitor_enabled" -eq 1 ]]; then
  monitor_log=$(mktemp /tmp/deepseek-sidecar-monitor.XXXXXX)
  monitor_done="$monitor_log.done"
  monitor_session="$monitor_log.session"
  terminal_chat="${SCRIPT_DIR}/terminal-chat"
  wrapper_entry="${SCRIPT_DIR}/codex-deepseek-sidecar"
  monitor_effort="$effective_effort"
  if ! /usr/bin/osascript - "$monitor_log" "$monitor_done" "$monitor_session" "$terminal_chat" "$wrapper_entry" "$profile" "$profile_model" "$monitor_effort" "$run_workdir" <<'OSA' >/dev/null 2>&1
on run argv
  set logFile to item 1 of argv
  set doneFile to item 2 of argv
  set sessionFile to item 3 of argv
  set chatScript to item 4 of argv
  set wrapperEntry to item 5 of argv
  set profileName to item 6 of argv
  set modelName to item 7 of argv
  set reasoningEffort to item 8 of argv
  set workingDirectory to item 9 of argv
  tell application "Terminal"
    activate
    do script quoted form of chatScript & " " & quoted form of logFile & " " & quoted form of doneFile & " " & quoted form of sessionFile & " " & quoted form of wrapperEntry & " " & quoted form of profileName & " " & quoted form of modelName & " " & quoted form of reasoningEffort & " " & quoted form of workingDirectory
  end tell
end run
OSA
  then
    echo "warning: could not open Terminal monitor; continuing without a visible window" >&2
    monitor_enabled=0
    rm -f "$monitor_log"
    monitor_log=""
    monitor_done=""
    monitor_session=""
  fi
fi

stream_stderr() {
  tee "$tmp_stderr" | filter_stderr | write_visible_output >&2
}

# shellcheck disable=SC2329
cleanup() {
  if [[ -n "$stderr_pid" ]] && kill -0 "$stderr_pid" 2>/dev/null; then
    kill "$stderr_pid" 2>/dev/null || true
    wait "$stderr_pid" 2>/dev/null || true
  fi
  if [[ -n "$monitor_done" ]]; then
    touch "$monitor_done"
  fi
  rm -f "$tmp_stderr" "$stderr_pipe"
  rmdir "$tmp_dir" 2>/dev/null || true
  if [[ -n "$lock_dir" ]]; then
    remove_stale_lock
  fi
}
trap cleanup EXIT

stream_stderr < "$stderr_pipe" &
stderr_pid=$!

set +e
if [[ ${#args[@]} -eq 1 && "${args[0]}" == "-" ]]; then
  (cd "$run_workdir" && "${clean_env[@]}" "${cmd[@]}" -) 2>"$stderr_pipe" | write_visible_output
  pipe_status=("${PIPESTATUS[@]}")
  exit_code=${pipe_status[0]}
else
  printf '%s\n' "${args[*]}" | (cd "$run_workdir" && "${clean_env[@]}" "${cmd[@]}" -) 2>"$stderr_pipe" | write_visible_output
  pipe_status=("${PIPESTATUS[@]}")
  exit_code=${pipe_status[1]}
fi
wait "$stderr_pid"
stderr_pid=""
set -e

if [[ -z "$session_id" ]]; then
  new_sid=$(sed -n 's/.*session id: \([0-9a-f-]*\).*/\1/p' "$tmp_stderr" | head -1)
  if [[ -n "$new_sid" ]]; then
    if [[ -n "$task_id" ]]; then
      echo "workdir=${workdir} task_id=${task_id} profile=${profile} effort=${effective_effort} session_id=${new_sid}" >> "$SESSION_FILE"
    else
      echo "workdir=${workdir} profile=${profile} effort=${effective_effort} session_id=${new_sid}" >> "$SESSION_FILE"
    fi
    if [[ -n "$monitor_session" ]]; then
      printf '%s\n' "$new_sid" > "$monitor_session"
    fi
  fi
elif [[ -n "$monitor_session" ]]; then
  printf '%s\n' "$session_id" > "$monitor_session"
fi

exit "$exit_code"
