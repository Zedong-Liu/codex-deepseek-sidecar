#!/usr/bin/env python3
"""Minimal Responses-to-DeepSeek proxy for Codex sidecars."""

from __future__ import annotations

import argparse
import base64
import html
import json
import os
import re
import sys
import threading
import time
import uuid
import urllib.error
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from typing import Any


DEFAULT_HOST = "127.0.0.1"
DEFAULT_PORT = 12359
DEFAULT_UPSTREAM = "https://api.deepseek.com"
DEFAULT_MAX_BODY = 128 * 1024 * 1024
DEFAULT_TIMEOUT = 900
MODELS = ("deepseek-v4-flash", "deepseek-v4-pro")
REASONING_ENVELOPE_PREFIX = "deepseek-reasoning-v1:"
# DeepSeek V4 documentation shows `｜DSML｜`; the official Flash endpoint can
# emit the tokenizer's doubled delimiter `｜｜DSML｜｜` instead.
DSML_TOKEN_PATTERN = r"(?:\|+|｜+)DSML(?:\|+|｜+)"
DSML_TOOL_BLOCK_RE = re.compile(
    rf"<(?P<token>{DSML_TOKEN_PATTERN})tool_calls>\s*(?P<body>.*?)\s*</(?P=token)tool_calls>",
    re.DOTALL,
)


class ProxyRequestError(Exception):
    def __init__(self, message: str, status: int = 400) -> None:
        super().__init__(message)
        self.status = status


class ProxyMetrics:
    """Payload-free proxy health and cache counters."""

    def __init__(self) -> None:
        self.lock = threading.Lock()
        self.started_at = now()
        self.request_count = 0
        self.response_count = 0
        self.error_count = 0
        self.cache_hit_tokens = 0
        self.cache_miss_tokens = 0
        self.last_request_at: int | None = None
        self.last_error_at: int | None = None

    def request(self) -> None:
        with self.lock:
            self.request_count += 1
            self.last_request_at = now()

    def response(self, status: int) -> None:
        with self.lock:
            self.response_count += 1
            if status >= 400:
                self.error_count += 1
                self.last_error_at = now()

    def usage(self, usage: dict[str, Any]) -> None:
        with self.lock:
            self.cache_hit_tokens += int(usage.get("prompt_cache_hit_tokens") or 0)
            self.cache_miss_tokens += int(usage.get("prompt_cache_miss_tokens") or 0)

    def snapshot(self) -> dict[str, Any]:
        with self.lock:
            return {
                "status": "ok",
                "started_at": self.started_at,
                "request_count": self.request_count,
                "response_count": self.response_count,
                "error_count": self.error_count,
                "cache_hit_tokens": self.cache_hit_tokens,
                "cache_miss_tokens": self.cache_miss_tokens,
                "last_request_at": self.last_request_at,
                "last_error_at": self.last_error_at,
            }


def now() -> int:
    return int(time.time())


def json_dumps(value: Any) -> str:
    return json.dumps(value, ensure_ascii=False, separators=(",", ":"))


def read_key_file(path: str) -> str:
    try:
        with open(os.path.expanduser(path), encoding="utf-8") as file:
            for line in file:
                key = line.strip()
                if key and not key.startswith("#"):
                    return key
    except OSError:
        return ""
    return ""


def content_to_text(content: Any, *, include_reasoning: bool = False) -> str:
    if content is None:
        return ""
    if isinstance(content, str):
        return content
    if isinstance(content, dict):
        if content.get("type") == "input_image":
            return ""
        if content.get("type") == "reasoning" and not include_reasoning:
            return ""
        text = content.get("text")
        if text is None:
            text = content.get("input_text")
        if text is None:
            text = content.get("output_text")
        return str(text) if text is not None else ""
    if isinstance(content, list):
        parts: list[str] = []
        for part in content:
            if isinstance(part, str):
                parts.append(part)
            elif isinstance(part, dict):
                if part.get("type") == "reasoning" and not include_reasoning:
                    continue
                text = part.get("text")
                if text is None:
                    text = part.get("input_text")
                if text is None:
                    text = part.get("output_text")
                if text is not None:
                    parts.append(str(text))
        return "\n".join(p for p in parts if p)
    return str(content)


def encode_reasoning(reasoning: str) -> str:
    """Return an opaque Responses continuation field, never user-visible text."""
    encoded = base64.urlsafe_b64encode(reasoning.encode("utf-8")).decode("ascii")
    return f"{REASONING_ENVELOPE_PREFIX}{encoded}"


def decode_reasoning(value: Any) -> str:
    if not isinstance(value, str) or not value.startswith(REASONING_ENVELOPE_PREFIX):
        return ""
    try:
        return base64.urlsafe_b64decode(value[len(REASONING_ENVELOPE_PREFIX) :]).decode("utf-8")
    except (UnicodeDecodeError, ValueError):
        return ""


def recover_dsml_tool_calls(text: str) -> tuple[str, list[dict[str, str]]]:
    """Decode DeepSeek V4's DSML fallback into OpenAI-style function calls.

    The official API normally exposes `tool_calls`, but V4 Flash can emit its
    native DSML tool block as plain content.  Treating that block as assistant
    text makes Codex finish the turn without executing the requested tool.
    """
    matches = list(DSML_TOOL_BLOCK_RE.finditer(text))
    if not matches:
        return text, []

    recovered: list[dict[str, str]] = []
    visible: list[str] = []
    cursor = 0
    for match in matches:
        token = match.group("token")
        invoke_re = re.compile(
            rf"<{re.escape(token)}invoke\s+name=(?P<quote>[\"'])(?P<name>.*?)(?P=quote)\s*>"
            rf"\s*(?P<body>.*?)\s*</{re.escape(token)}invoke>",
            re.DOTALL,
        )
        calls = list(invoke_re.finditer(match.group("body")))
        if not calls:
            return text, []
        parsed_calls: list[dict[str, str]] = []
        for call in calls:
            parameters: dict[str, Any] = {}
            parameter_re = re.compile(
                rf"<{re.escape(token)}parameter\s+(?P<attrs>[^>]*)>"
                rf"(?P<value>.*?)</{re.escape(token)}parameter>",
                re.DOTALL,
            )
            for parameter in parameter_re.finditer(call.group("body")):
                attrs = {
                    name: value
                    for name, _, value in re.findall(
                        r"([A-Za-z_][A-Za-z0-9_]*)=([\"'])(.*?)\2", parameter.group("attrs")
                    )
                }
                name = attrs.get("name")
                if not name:
                    return text, []
                value = html.unescape(parameter.group("value").strip())
                if attrs.get("string", "false").lower() == "true":
                    parameters[name] = value
                else:
                    try:
                        parameters[name] = json.loads(value)
                    except json.JSONDecodeError:
                        return text, []
            name = html.unescape(call.group("name"))
            if name.startswith("functions."):
                name = name.removeprefix("functions.")
            if not name:
                return text, []
            parsed_calls.append(
                {
                    "id": f"call_{uuid.uuid4().hex}",
                    "name": name,
                    "arguments": json_dumps(parameters),
                }
            )
        visible.append(text[cursor : match.start()])
        cursor = match.end()
        recovered.extend(parsed_calls)
    visible.append(text[cursor:])
    return "".join(visible).strip(), recovered


def reasoning_to_text(item: dict[str, Any]) -> str:
    preserved = decode_reasoning(item.get("encrypted_content"))
    if preserved:
        return preserved
    content = item.get("content")
    if isinstance(content, list):
        parts = [
            content_to_text(part, include_reasoning=True)
            for part in content
            if isinstance(part, dict) and part.get("type") == "reasoning"
        ]
        result = "\n".join(part for part in parts if part)
        if result:
            return result
    summary = item.get("summary")
    if isinstance(summary, list):
        return "\n".join(content_to_text(part, include_reasoning=True) for part in summary if part)
    return str(item.get("reasoning_content") or item.get("text") or "")


def append_function_call_message(
    messages: list[dict[str, Any]],
    item: dict[str, Any],
    reasoning_by_call_id: dict[str, str] | None = None,
) -> None:
    call_id = item.get("call_id") or item.get("id") or f"call_{uuid.uuid4().hex}"
    preserved_reasoning = (reasoning_by_call_id or {}).get(str(call_id), "")
    tool_call = {
        "id": call_id,
        "type": "function",
        "function": {
            "name": item.get("name", ""),
            "arguments": item.get("arguments", "{}"),
        },
    }
    if messages and messages[-1].get("role") == "assistant":
        messages[-1].setdefault("tool_calls", []).append(tool_call)
        if preserved_reasoning and not messages[-1].get("reasoning_content"):
            messages[-1]["reasoning_content"] = preserved_reasoning
        return
    message: dict[str, Any] = {"role": "assistant", "content": None, "tool_calls": [tool_call]}
    if preserved_reasoning:
        message["reasoning_content"] = preserved_reasoning
    messages.append(message)


def normalize_messages(messages: list[dict[str, Any]]) -> list[dict[str, Any]]:
    """Remove impossible assistant history entries before DeepSeek sees them.

    Codex can resend a standalone Responses `reasoning` item while resuming a
    session. DeepSeek permits reasoning only as metadata on an assistant turn
    which also has text or tool calls; a bare assistant turn is rejected.
    Retain that reasoning only for an assistant tool-call turn, the one case
    where DeepSeek requires it for continuation. Drop it for ordinary
    assistant/user turns: DeepSeek ignores it there and replaying it needlessly
    grows every later prompt.
    """
    normalized: list[dict[str, Any]] = []
    pending_reasoning: list[str] = []
    for message in messages:
        if message.get("role") != "assistant":
            normalized.append(message)
            continue

        reasoning = str(message.pop("reasoning_content", "") or "")
        content = message.get("content")
        has_content = isinstance(content, str) and bool(content.strip())
        has_tool_calls = bool(message.get("tool_calls"))
        if not has_content and not has_tool_calls:
            if reasoning:
                pending_reasoning.append(reasoning)
            continue

        if has_tool_calls and pending_reasoning:
            prior_reasoning = "\n".join(pending_reasoning)
            pending_reasoning.clear()
            message["reasoning_content"] = "\n".join(
                part for part in (prior_reasoning, reasoning) if part
            )
        elif has_tool_calls and reasoning:
            message["reasoning_content"] = reasoning
        else:
            pending_reasoning.clear()
        normalized.append(message)
    return normalized


def response_input_to_messages(
    payload: dict[str, Any], reasoning_by_call_id: dict[str, str] | None = None
) -> list[dict[str, Any]]:
    messages: list[dict[str, Any]] = []
    instructions = payload.get("instructions")
    if instructions:
        messages.append({"role": "system", "content": str(instructions)})

    input_value = payload.get("input", "")
    if isinstance(input_value, str):
        if input_value:
            messages.append({"role": "user", "content": input_value})
        return messages

    if not isinstance(input_value, list):
        messages.append({"role": "user", "content": content_to_text(input_value)})
        return messages

    for item in input_value:
        if isinstance(item, str):
            messages.append({"role": "user", "content": item})
            continue
        if not isinstance(item, dict):
            messages.append({"role": "user", "content": content_to_text(item)})
            continue

        item_type = item.get("type")
        role = item.get("role")
        if item_type == "function_call_output":
            call_id = str(item.get("call_id") or item.get("id") or "call_0")
            messages.append(
                {
                    "role": "tool",
                    "tool_call_id": call_id,
                    "content": content_to_text(item.get("output", "")),
                }
            )
            if reasoning_by_call_id is not None:
                reasoning_by_call_id.pop(call_id, None)
            continue
        if item_type == "function_call":
            append_function_call_message(messages, item, reasoning_by_call_id)
            continue
        if item_type == "reasoning":
            reasoning = reasoning_to_text(item)
            if reasoning:
                if messages and messages[-1].get("role") == "assistant":
                    messages[-1]["reasoning_content"] = reasoning
                else:
                    messages.append({"role": "assistant", "content": None, "reasoning_content": reasoning})
            continue

        if item_type == "message" or role:
            chat_role = role or "user"
            if chat_role == "developer":
                chat_role = "system"
            if chat_role not in ("system", "user", "assistant", "tool"):
                chat_role = "user"
            msg: dict[str, Any] = {
                "role": chat_role,
                "content": content_to_text(item.get("content", "")),
            }
            if chat_role == "assistant":
                reasoning = reasoning_to_text(item)
                if reasoning:
                    msg["reasoning_content"] = reasoning
            if chat_role == "tool":
                msg["tool_call_id"] = item.get("tool_call_id") or item.get("call_id") or "call_0"
            messages.append(msg)
            continue

        text = content_to_text(item.get("content", item))
        if text:
            messages.append({"role": "user", "content": text})

    return normalize_messages(messages)


def response_tools_to_chat_tools(tools: Any, *, beta: bool) -> list[dict[str, Any]] | None:
    if not isinstance(tools, list) or not tools:
        return None
    chat_tools: list[dict[str, Any]] = []
    for tool in tools:
        if not isinstance(tool, dict):
            continue
        if tool.get("type") != "function":
            continue
        function = tool.get("function")
        if isinstance(function, dict):
            name = function.get("name")
            description = function.get("description", "")
            parameters = function.get("parameters", {})
            strict = function.get("strict", tool.get("strict"))
        else:
            name = tool.get("name")
            description = tool.get("description", "")
            parameters = tool.get("parameters", {})
            strict = tool.get("strict")
        if not name:
            continue
        chat_function: dict[str, Any] = {
            "name": name,
            "description": description,
            "parameters": parameters or {"type": "object", "properties": {}},
        }
        if strict is not None and beta:
            chat_function["strict"] = bool(strict)
        chat_tools.append({"type": "function", "function": chat_function})
    return chat_tools or None


def allowed_tool_names(choice: Any) -> set[str] | None:
    if not isinstance(choice, dict) or choice.get("type") != "allowed_tools":
        return None
    names: set[str] = set()
    for tool in choice.get("tools") or []:
        if isinstance(tool, dict) and tool.get("type") == "function" and tool.get("name"):
            names.add(str(tool["name"]))
    return names or None


def filter_allowed_tools(
    tools: list[dict[str, Any]] | None, choice: Any
) -> list[dict[str, Any]] | None:
    names = allowed_tool_names(choice)
    if not names or not tools:
        return tools
    filtered = [tool for tool in tools if tool["function"]["name"] in names]
    if not filtered:
        raise ProxyRequestError("tool_choice allowed_tools did not match any function tools")
    return filtered


def tool_choice_to_chat(choice: Any) -> Any:
    if choice in (None, "auto", "none", "required"):
        return choice
    if isinstance(choice, dict):
        if choice.get("type") == "allowed_tools":
            mode = choice.get("mode", "auto")
            return mode if mode in ("auto", "required", "none") else "auto"
        name = choice.get("name")
        if not name and isinstance(choice.get("function"), dict):
            name = choice["function"].get("name")
        if name:
            return {"type": "function", "function": {"name": name}}
    return "auto"


def unsupported_required_tool_choice(choice: Any, tools: Any) -> str | None:
    if not isinstance(choice, dict):
        return None
    if choice.get("type") == "allowed_tools":
        return None
    choice_type = str(choice.get("type") or "")
    if choice_type == "function":
        return None
    requested = str(choice.get("name") or choice_type or "unknown")
    if requested in ("auto", "none", "required"):
        return None
    tool_types: set[str] = set()
    if isinstance(tools, list):
        for tool in tools:
            if isinstance(tool, dict):
                tool_types.add(str(tool.get("type") or ""))
    if requested in tool_types or choice_type:
        return requested
    return None


def deepseek_reasoning_effort(payload: dict[str, Any]) -> str | None:
    effort = payload.get("reasoning_effort")
    reasoning = payload.get("reasoning")
    if effort is None and isinstance(reasoning, dict):
        effort = reasoning.get("effort")
    if effort in ("low", "medium", "high"):
        return "high"
    if effort in ("xhigh", "max", "ultra"):
        return "max"
    return None


def runtime_identity_instruction(model: str) -> str:
    return (
        f"Runtime identity: you are {model}, a DeepSeek model accessed through "
        "the Codex sidecar. When asked which model you are, state this truthfully; "
        "do not claim to be GPT-5 or another OpenAI model."
    )


def responses_to_chat(
    payload: dict[str, Any], *, beta: bool = False, reasoning_by_call_id: dict[str, str] | None = None
) -> dict[str, Any]:
    model = str(payload.get("model", MODELS[0]))
    messages = response_input_to_messages(payload, reasoning_by_call_id)
    identity = runtime_identity_instruction(model)
    if messages and messages[0].get("role") == "system":
        existing = str(messages[0].get("content") or "")
        messages[0]["content"] = f"{existing}\n\n{identity}" if existing else identity
    else:
        messages.insert(0, {"role": "system", "content": identity})
    chat: dict[str, Any] = {
        "model": model,
        "messages": messages,
        "stream": bool(payload.get("stream", False)),
    }
    passthrough = (
        "temperature",
        "top_p",
        "frequency_penalty",
        "presence_penalty",
        "stop",
        "response_format",
    )
    for key in passthrough:
        if key in payload:
            chat[key] = payload[key]
    reasoning_effort = deepseek_reasoning_effort(payload)
    if reasoning_effort:
        chat["reasoning_effort"] = reasoning_effort
        chat["thinking"] = {"type": "enabled"}
    if "max_output_tokens" in payload:
        chat["max_tokens"] = payload["max_output_tokens"]
    elif "max_tokens" in payload:
        chat["max_tokens"] = payload["max_tokens"]
    required_unsupported = unsupported_required_tool_choice(
        payload.get("tool_choice"), payload.get("tools")
    )
    if required_unsupported:
        raise ProxyRequestError(
            f"tool_choice requires unsupported Responses tool: {required_unsupported}. "
            "deepseek-responses-proxy only bridges function tools."
        )
    tools = filter_allowed_tools(
        response_tools_to_chat_tools(payload.get("tools"), beta=beta), payload.get("tool_choice")
    )
    if tools:
        chat["tools"] = tools
        chat["tool_choice"] = tool_choice_to_chat(payload.get("tool_choice", "auto"))
        if "parallel_tool_calls" in payload:
            chat["parallel_tool_calls"] = bool(payload["parallel_tool_calls"])
    return chat


def usage_to_responses(usage: dict[str, Any] | None) -> dict[str, Any]:
    usage = usage or {}
    input_tokens = int(usage.get("prompt_tokens") or usage.get("input_tokens") or 0)
    output_tokens = int(usage.get("completion_tokens") or usage.get("output_tokens") or 0)
    total_tokens = int(usage.get("total_tokens") or input_tokens + output_tokens)
    response_usage: dict[str, Any] = {
        "input_tokens": input_tokens,
        "output_tokens": output_tokens,
        "total_tokens": total_tokens,
    }
    cache_hit = int(usage.get("prompt_cache_hit_tokens") or 0)
    cache_miss = int(usage.get("prompt_cache_miss_tokens") or 0)
    if cache_hit or cache_miss:
        response_usage["input_tokens_details"] = {"cached_tokens": cache_hit}
        response_usage["prompt_cache_hit_tokens"] = cache_hit
        response_usage["prompt_cache_miss_tokens"] = cache_miss
    return response_usage


def chat_to_response(payload: dict[str, Any], model: str) -> dict[str, Any]:
    choice = (payload.get("choices") or [{}])[0]
    message = choice.get("message") or {}
    output: list[dict[str, Any]] = []
    output_text = message.get("content") or ""
    reasoning_content = message.get("reasoning_content") or ""
    tool_calls = message.get("tool_calls") or []
    if not tool_calls and output_text:
        output_text, recovered_calls = recover_dsml_tool_calls(output_text)
        if recovered_calls:
            tool_calls = [
                {
                    "id": call["id"],
                    "function": {"name": call["name"], "arguments": call["arguments"]},
                }
                for call in recovered_calls
            ]
    # DeepSeek requires reasoning replay only across tool-call turns. Returning
    # it for ordinary chat makes Codex resend a large, ignored chain of thought
    # on every subsequent user message.
    if reasoning_content and tool_calls:
        output.append(
            {
                "type": "reasoning",
                "id": f"rsn_{uuid.uuid4().hex}",
                "status": "completed",
                "encrypted_content": encode_reasoning(reasoning_content),
            }
        )
    if output_text:
        output.append(
            {
                "type": "message",
                "id": f"msg_{uuid.uuid4().hex}",
                "status": "completed",
                "role": "assistant",
                "content": [
                    {
                        "type": "output_text",
                        "text": output_text,
                        "annotations": [],
                    }
                ],
            }
        )
    for tool_call in tool_calls:
        function = tool_call.get("function") or {}
        output.append(
            {
                "type": "function_call",
                "id": f"fc_{uuid.uuid4().hex}",
                "call_id": tool_call.get("id") or f"call_{uuid.uuid4().hex}",
                "name": function.get("name", ""),
                "arguments": function.get("arguments", "{}"),
                "status": "completed",
            }
        )
    return {
        "id": f"resp_{uuid.uuid4().hex}",
        "object": "response",
        "created_at": payload.get("created") or now(),
        "status": "completed",
        "model": payload.get("model") or model,
        "output": output,
        "output_text": output_text,
        "usage": usage_to_responses(payload.get("usage")),
    }


def build_models_response(models: tuple[str, ...] = MODELS) -> dict[str, Any]:
    reasoning_levels = [
        {"effort": "low", "description": "Fast responses with lighter reasoning"},
        {"effort": "medium", "description": "Balances speed and reasoning depth"},
        {"effort": "high", "description": "Greater reasoning depth for complex tasks"},
    ]
    catalog = [
        {
            "slug": model,
            "display_name": model.replace("-", " "),
            "description": "DeepSeek via the local Responses proxy.",
            "default_reasoning_level": "medium",
            "supported_reasoning_levels": reasoning_levels,
            "shell_type": "shell_command",
            "visibility": "list",
            "supported_in_api": True,
            "priority": 1,
            "additional_speed_tiers": [],
            "availability_nux": None,
            "upgrade": None,
            "base_instructions": "",
            "model_messages": {"instructions_template": ""},
            "supports_reasoning_summaries": True,
            "default_reasoning_summary": "none",
            "support_verbosity": True,
            "default_verbosity": "medium",
            "apply_patch_tool_type": "freeform",
            "web_search_tool_type": "text_and_image",
            "truncation_policy": {"mode": "tokens", "limit": 10000},
            "supports_parallel_tool_calls": True,
            "supports_image_detail_original": False,
            "context_window": 1048576,
            "max_context_window": 1048576,
            "effective_context_window_percent": 65,
            "experimental_supported_tools": [],
            "input_modalities": ["text"],
            "supports_search_tool": False,
        }
        for model in models
    ]
    return {
        "fetched_at": f"{now()}s since unix epoch",
        "models": catalog,
        "object": "list",
        "data": [
            {"id": model, "object": "model", "created": 0, "owned_by": "deepseek"}
            for model in models
        ],
    }


class ProxyHandler(BaseHTTPRequestHandler):
    server_version = "deepseek-responses-proxy/0.1"

    def log_message(self, fmt: str, *args: Any) -> None:
        if getattr(self.server, "quiet", False):
            return
        super().log_message(fmt, *args)

    def send_json(self, status: int, payload: dict[str, Any]) -> None:
        data = json_dumps(payload).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)
        self.server.metrics.response(status)

    def send_error_json(self, status: int, message: str) -> None:
        self.send_json(status, {"error": {"message": message, "type": "proxy_error"}})

    def do_GET(self) -> None:
        path = self.path.split("?", 1)[0]
        beta = path.startswith("/beta/")
        self.server.metrics.request()
        if path in ("/health", "/v1/health", "/beta/health", "/beta/v1/health"):
            self.send_json(200, {"status": "ok"})
        elif path in ("/ready", "/v1/ready", "/beta/ready", "/beta/v1/ready"):
            self.handle_ready(beta=beta)
        elif path in ("/metrics", "/v1/metrics", "/beta/metrics", "/beta/v1/metrics"):
            self.send_json(200, self.server.metrics.snapshot())
        elif path in ("/models", "/v1/models", "/beta/models", "/beta/v1/models"):
            self.handle_models(beta=beta)
        else:
            self.send_error_json(404, f"unsupported path: {path}")

    def do_POST(self) -> None:
        path = self.path.split("?", 1)[0]
        beta = path.startswith("/beta/")
        self.server.metrics.request()
        try:
            body = self.read_body()
            payload = json.loads(body.decode("utf-8"))
        except Exception as exc:
            self.send_error_json(400, f"invalid JSON request: {exc}")
            return

        if path in ("/responses", "/v1/responses", "/beta/responses", "/beta/v1/responses"):
            self.handle_responses(payload, beta=beta)
        elif path in ("/chat/completions", "/v1/chat/completions", "/beta/chat/completions", "/beta/v1/chat/completions"):
            self.forward_chat(payload, beta=beta)
        else:
            self.send_error_json(404, f"unsupported path: {path}")

    def upstream_base(self, *, beta: bool) -> str:
        upstream = getattr(self.server, "upstream", DEFAULT_UPSTREAM).rstrip("/")
        return f"{upstream}/beta" if beta else upstream

    def upstream_models(self, *, beta: bool) -> tuple[str, ...]:
        api_key = os.environ.get(getattr(self.server, "api_key_env", "DEEPSEEK_API_KEY"))
        api_key_file = getattr(self.server, "api_key_file", "")
        if not api_key and api_key_file:
            api_key = read_key_file(api_key_file)
        if not api_key:
            raise RuntimeError("missing API key")
        request = urllib.request.Request(
            # DeepSeek's beta route is for beta request features. Model
            # discovery remains on the stable OpenAI-compatible endpoint.
            f"{self.upstream_base(beta=False)}/models",
            headers={"Authorization": f"Bearer {api_key}"},
            method="GET",
        )
        timeout = getattr(self.server, "timeout", DEFAULT_TIMEOUT)
        with urllib.request.urlopen(request, timeout=timeout) as response:
            payload = json.loads(response.read().decode("utf-8"))
        return tuple(
            str(item["id"])
            for item in payload.get("data", [])
            if isinstance(item, dict) and item.get("id")
        )

    def handle_models(self, *, beta: bool) -> None:
        try:
            models = self.upstream_models(beta=beta)
            self.send_json(200, build_models_response(models or MODELS))
        except Exception:
            self.send_json(200, build_models_response())

    def handle_ready(self, *, beta: bool) -> None:
        try:
            models = self.upstream_models(beta=beta)
            self.send_json(200, {"status": "ok", "models": list(models), "beta": beta})
        except urllib.error.HTTPError as exc:
            self.send_error_json(exc.code, "official DeepSeek API rejected readiness check")
        except Exception:
            self.send_error_json(503, "official DeepSeek API is unavailable")

    def read_body(self) -> bytes:
        length = int(self.headers.get("Content-Length") or "0")
        max_body = getattr(self.server, "max_body_bytes", DEFAULT_MAX_BODY)
        if length > max_body:
            raise ValueError(f"request body too large: {length} bytes > {max_body} bytes")
        return self.rfile.read(length)

    def upstream_request(self, payload: dict[str, Any], stream: bool, *, beta: bool) -> urllib.response.addinfourl:
        api_key = os.environ.get(getattr(self.server, "api_key_env", "DEEPSEEK_API_KEY"))
        api_key_file = getattr(self.server, "api_key_file", "")
        if not api_key and api_key_file:
            api_key = read_key_file(api_key_file)
        if not api_key:
            key_source = getattr(self.server, "api_key_env", "DEEPSEEK_API_KEY")
            if api_key_file:
                key_source = f"{key_source} or {api_key_file}"
            raise RuntimeError(f"missing {key_source}")
        url = f"{self.upstream_base(beta=beta)}/chat/completions"
        data = json_dumps(payload).encode("utf-8")
        request = urllib.request.Request(
            url,
            data=data,
            headers={
                "Authorization": f"Bearer {api_key}",
                "Content-Type": "application/json",
                "Accept": "text/event-stream" if stream else "application/json",
            },
            method="POST",
        )
        timeout = getattr(self.server, "timeout", DEFAULT_TIMEOUT)
        return urllib.request.urlopen(request, timeout=timeout)

    def handle_responses(self, payload: dict[str, Any], *, beta: bool) -> None:
        try:
            chat_payload = responses_to_chat(
                payload, beta=beta, reasoning_by_call_id=self.server.reasoning_by_call_id
            )
        except ProxyRequestError as exc:
            self.send_error_json(exc.status, str(exc))
            return
        if chat_payload.get("stream"):
            self.forward_streaming_response(chat_payload, beta=beta)
            return
        try:
            upstream = self.upstream_request(chat_payload, stream=False, beta=beta)
            data = upstream.read()
            chat_response = json.loads(data.decode("utf-8"))
            self.server.metrics.usage(chat_response.get("usage") or {})
            response_payload = chat_to_response(chat_response, chat_payload["model"])
            reasoning = str(((chat_response.get("choices") or [{}])[0].get("message") or {}).get("reasoning_content") or "")
            if reasoning:
                for item in response_payload["output"]:
                    if item.get("type") == "function_call":
                        self.server.reasoning_by_call_id[str(item["call_id"])] = reasoning
            self.send_json(200, response_payload)
        except urllib.error.HTTPError as exc:
            self.forward_upstream_error(exc)
        except Exception as exc:
            self.send_error_json(502, str(exc))

    def forward_chat(self, payload: dict[str, Any], *, beta: bool) -> None:
        try:
            upstream = self.upstream_request(payload, stream=bool(payload.get("stream")), beta=beta)
            content_type = upstream.headers.get("Content-Type", "application/json")
            self.send_response(upstream.status)
            self.send_header("Content-Type", content_type)
            self.end_headers()
            while True:
                chunk = upstream.read(64 * 1024)
                if not chunk:
                    break
                self.wfile.write(chunk)
                self.wfile.flush()
            self.server.metrics.response(upstream.status)
        except urllib.error.HTTPError as exc:
            self.forward_upstream_error(exc)
        except Exception as exc:
            self.send_error_json(502, str(exc))

    def forward_upstream_error(self, exc: urllib.error.HTTPError) -> None:
        data = exc.read()
        self.send_response(exc.code)
        self.send_header("Content-Type", exc.headers.get("Content-Type", "application/json"))
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)
        self.server.metrics.response(exc.code)

    def sse(self, event: str, data: dict[str, Any]) -> None:
        packet = f"event: {event}\ndata: {json_dumps(data)}\n\n".encode("utf-8")
        self.wfile.write(packet)
        self.wfile.flush()

    def forward_streaming_response(self, chat_payload: dict[str, Any], *, beta: bool) -> None:
        response_id = f"resp_{uuid.uuid4().hex}"
        model = chat_payload["model"]
        try:
            upstream = self.upstream_request(chat_payload, stream=True, beta=beta)
        except urllib.error.HTTPError as exc:
            self.forward_upstream_error(exc)
            return
        except Exception as exc:
            self.send_error_json(502, str(exc))
            return

        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream; charset=utf-8")
        self.send_header("Cache-Control", "no-cache")
        self.end_headers()

        output_index = 0
        next_output_index = 0
        text_output_index: int | None = None
        text_item_id = ""
        text = ""
        tool_indexes: dict[int, int] = {}
        tool_calls: dict[int, dict[str, str]] = {}
        completed_output: list[dict[str, Any]] = []
        stream_usage: dict[str, Any] | None = None
        reasoning_content = ""

        self.sse(
            "response.created",
            {
                "type": "response.created",
                "response": {
                    "id": response_id,
                    "object": "response",
                    "created_at": now(),
                    "status": "in_progress",
                    "model": model,
                    "output": [],
                },
            },
        )

        for raw_line in upstream:
            line = raw_line.decode("utf-8", errors="replace").strip()
            if not line or not line.startswith("data:"):
                continue
            data_text = line[5:].strip()
            if data_text == "[DONE]":
                break
            try:
                chunk = json.loads(data_text)
            except json.JSONDecodeError:
                continue
            if isinstance(chunk.get("usage"), dict):
                stream_usage = chunk["usage"]
            choice = (chunk.get("choices") or [{}])[0]
            delta = choice.get("delta") or {}
            if delta.get("reasoning_content"):
                reasoning_content += str(delta["reasoning_content"])
            content = delta.get("content")
            if content:
                text += content

            for tool_call in delta.get("tool_calls") or []:
                idx = int(tool_call.get("index", 0))
                function = tool_call.get("function") or {}
                if idx not in tool_indexes:
                    tool_indexes[idx] = next_output_index
                    next_output_index += 1
                    tool_calls[idx] = {
                        "item_id": f"fc_{uuid.uuid4().hex}",
                        "call_id": tool_call.get("id") or f"call_{uuid.uuid4().hex}",
                        "name": function.get("name") or "",
                        "arguments": "",
                    }
                    self.sse(
                        "response.output_item.added",
                        {
                            "type": "response.output_item.added",
                            "output_index": tool_indexes[idx],
                            "item": {
                                "type": "function_call",
                                "id": tool_calls[idx]["item_id"],
                                "call_id": tool_calls[idx]["call_id"],
                                "name": tool_calls[idx]["name"],
                                "arguments": "",
                                "status": "in_progress",
                            },
                        },
                    )
                if function.get("name"):
                    tool_calls[idx]["name"] = function["name"]
                if function.get("arguments"):
                    tool_calls[idx]["arguments"] += function["arguments"]
                    self.sse(
                        "response.function_call_arguments.delta",
                        {
                            "type": "response.function_call_arguments.delta",
                            "output_index": tool_indexes[idx],
                            "delta": function["arguments"],
                        },
                    )

        if not tool_calls and text:
            text, recovered_calls = recover_dsml_tool_calls(text)
            for call in recovered_calls:
                idx = len(tool_calls)
                tool_indexes[idx] = next_output_index
                next_output_index += 1
                tool_calls[idx] = {
                    "item_id": f"fc_{uuid.uuid4().hex}",
                    "call_id": call["id"],
                    "name": call["name"],
                    "arguments": call["arguments"],
                }
                self.sse(
                    "response.output_item.added",
                    {
                        "type": "response.output_item.added",
                        "output_index": tool_indexes[idx],
                        "item": {
                            "type": "function_call",
                            "id": tool_calls[idx]["item_id"],
                            "call_id": tool_calls[idx]["call_id"],
                            "name": tool_calls[idx]["name"],
                            "arguments": tool_calls[idx]["arguments"],
                            "status": "in_progress",
                        },
                    },
                )
                self.sse(
                    "response.function_call_arguments.delta",
                    {
                        "type": "response.function_call_arguments.delta",
                        "output_index": tool_indexes[idx],
                        "delta": tool_calls[idx]["arguments"],
                    },
                )

        if text:
            text_output_index = next_output_index
            next_output_index += 1
            text_item_id = f"msg_{uuid.uuid4().hex}"
            self.sse(
                "response.output_item.added",
                {
                    "type": "response.output_item.added",
                    "output_index": text_output_index,
                    "item": {
                        "type": "message",
                        "id": text_item_id,
                        "status": "in_progress",
                        "role": "assistant",
                        "content": [],
                    },
                },
            )
            self.sse(
                "response.content_part.added",
                {
                    "type": "response.content_part.added",
                    "output_index": text_output_index,
                    "content_index": 0,
                    "part": {"type": "output_text", "text": "", "annotations": []},
                },
            )

        if text_output_index is not None:
            text_item = {
                "type": "message",
                "id": text_item_id,
                "status": "completed",
                "role": "assistant",
                "content": [{"type": "output_text", "text": text, "annotations": []}],
            }
            self.sse(
                "response.output_text.done",
                {
                    "type": "response.output_text.done",
                    "output_index": text_output_index,
                    "content_index": 0,
                    "text": text,
                },
            )
            self.sse(
                "response.content_part.done",
                {
                    "type": "response.content_part.done",
                    "output_index": text_output_index,
                    "content_index": 0,
                    "part": {"type": "output_text", "text": text, "annotations": []},
                },
            )
            self.sse(
                "response.output_item.done",
                {
                    "type": "response.output_item.done",
                    "output_index": text_output_index,
                    "item": text_item,
                },
            )
            completed_output.append(text_item)
        for idx, item in tool_calls.items():
            tool_item = {
                "type": "function_call",
                "id": item["item_id"],
                "call_id": item["call_id"],
                "name": item["name"],
                "arguments": item["arguments"],
                "status": "completed",
            }
            self.sse(
                "response.function_call_arguments.done",
                {
                    "type": "response.function_call_arguments.done",
                    "output_index": tool_indexes[idx],
                    "arguments": item["arguments"],
                },
            )
            self.sse(
                "response.output_item.done",
                {
                    "type": "response.output_item.done",
                    "output_index": tool_indexes[idx],
                    "item": tool_item,
                },
            )
            completed_output.append(tool_item)
            if reasoning_content:
                self.server.reasoning_by_call_id[item["call_id"]] = reasoning_content
        if reasoning_content and tool_calls:
            reasoning_item = {
                "type": "reasoning",
                "id": f"rsn_{uuid.uuid4().hex}",
                "status": "completed",
                "encrypted_content": encode_reasoning(reasoning_content),
            }
            self.sse(
                "response.output_item.added",
                {
                    "type": "response.output_item.added",
                    "output_index": next_output_index,
                    "item": reasoning_item,
                },
            )
            self.sse(
                "response.output_item.done",
                {
                    "type": "response.output_item.done",
                    "output_index": next_output_index,
                    "item": reasoning_item,
                },
            )
            completed_output.insert(0, reasoning_item)
        self.server.metrics.usage(stream_usage or {})
        self.server.metrics.response(200)
        self.sse(
            "response.completed",
            {
                "type": "response.completed",
                "response": {
                    "id": response_id,
                    "object": "response",
                    "created_at": now(),
                    "status": "completed",
                    "model": model,
                    "output": completed_output,
                    "output_text": text,
                    "usage": usage_to_responses(stream_usage),
                },
            },
        )


def self_test() -> int:
    assert content_to_text(
        [
            {"type": "input_text", "text": "keep"},
            {"type": "input_image", "image_url": "data:image/png;base64,ignored"},
        ]
    ) == "keep"
    envelope = encode_reasoning("private continuation")
    assert reasoning_to_text({"encrypted_content": envelope}) == "private continuation"
    dsml = (
        '<｜DSML｜tool_calls>\n'
        '<｜DSML｜invoke name="functions.exec_command">\n'
        '<｜DSML｜parameter name="cmd" string="true">pwd</｜DSML｜parameter>\n'
        '</｜DSML｜invoke>\n'
        '</｜DSML｜tool_calls>'
    )
    visible, recovered = recover_dsml_tool_calls(dsml)
    assert visible == ""
    assert recovered[0]["name"] == "exec_command"
    assert json.loads(recovered[0]["arguments"]) == {"cmd": "pwd"}
    doubled_dsml = dsml.replace("｜DSML｜", "｜｜DSML｜｜")
    _, doubled_recovered = recover_dsml_tool_calls(doubled_dsml)
    assert doubled_recovered[0]["name"] == "exec_command"
    request = {
        "model": MODELS[0],
        "instructions": "Be concise.",
        "input": [
            {"role": "user", "content": [{"type": "input_text", "text": "Find bugs."}]},
            {
                "type": "function_call",
                "call_id": "call_1",
                "name": "shell",
                "arguments": "{\"cmd\":\"pwd\"}",
            },
            {
                "type": "function_call",
                "call_id": "call_2",
                "name": "read_file",
                "arguments": "{\"path\":\"README.md\"}",
            },
            {"type": "function_call_output", "call_id": "call_1", "output": "ok"},
        ],
        "tools": [
            {"type": "web_search_preview"},
            {
                "type": "function",
                "name": "shell",
                "description": "Run shell",
                "parameters": {"type": "object", "properties": {"cmd": {"type": "string"}}},
                "strict": True,
            },
            {
                "type": "function",
                "name": "read_file",
                "parameters": {"type": "object", "properties": {"path": {"type": "string"}}},
            }
        ],
        "tool_choice": {
            "type": "allowed_tools",
            "mode": "auto",
            "tools": [{"type": "function", "name": "shell"}],
        },
        "parallel_tool_calls": True,
        "max_output_tokens": 100,
    }
    chat = responses_to_chat(request, beta=True)
    assert chat["messages"][0]["role"] == "system"
    assert "deepseek-v4-flash" in chat["messages"][0]["content"]
    assert chat["messages"][1]["role"] == "user"
    assert chat["messages"][2]["role"] == "assistant"
    assert len(chat["messages"][2]["tool_calls"]) == 2
    assert chat["messages"][3]["role"] == "tool"
    assert len(chat["tools"]) == 1
    assert chat["tools"][0]["function"]["name"] == "shell"
    assert chat["tools"][0]["function"]["strict"] is True
    assert chat["parallel_tool_calls"] is True
    assert chat["max_tokens"] == 100
    assert responses_to_chat({"reasoning": {"effort": "medium"}})["reasoning_effort"] == "high"
    assert responses_to_chat({"reasoning_effort": "max"})["reasoning_effort"] == "max"
    assert responses_to_chat({"reasoning": {"effort": "max"}})["thinking"]["type"] == "enabled"
    assert "tools" not in responses_to_chat({"tools": [{"type": "web_search_preview"}]})
    stable_tools = responses_to_chat(request)["tools"]
    assert "strict" not in stable_tools[0]["function"]
    try:
        responses_to_chat(
            {
                "tools": [{"type": "web_search_preview"}],
                "tool_choice": {"type": "web_search_preview"},
            }
        )
        raise AssertionError("required unsupported built-in tool was not rejected")
    except ProxyRequestError:
        pass
    continued = response_input_to_messages(
        {
            "input": [
                {
                    "type": "reasoning",
                    "summary": [{"type": "summary_text", "text": "Need a tool."}],
                },
                {"type": "function_call", "call_id": "call_3", "name": "shell", "arguments": "{}"},
            ]
        }
    )
    assert continued[0]["reasoning_content"] == "Need a tool."
    assert continued[0]["tool_calls"][0]["function"]["name"] == "shell"
    tool_reasoning = {"call_4": "Required tool reasoning."}
    replayed_tool_turn = response_input_to_messages(
        {
            "input": [
                {"type": "function_call", "call_id": "call_4", "name": "shell", "arguments": "{}"},
                {"type": "function_call_output", "call_id": "call_4", "output": "ok"},
            ]
        },
        tool_reasoning,
    )
    assert replayed_tool_turn[0]["reasoning_content"] == "Required tool reasoning."
    assert tool_reasoning == {}
    resumed = response_input_to_messages(
        {
            "input": [
                {"type": "reasoning", "summary": [{"type": "summary_text", "text": "Check route."}]},
                {"type": "message", "role": "assistant", "content": []},
                {"type": "message", "role": "user", "content": [{"type": "input_text", "text": "continue"}]},
            ]
        }
    )
    assert resumed == [{"role": "user", "content": "continue"}]
    resumed_with_text = response_input_to_messages(
        {
            "input": [
                {"type": "reasoning", "summary": [{"type": "summary_text", "text": "Check route."}]},
                {"type": "message", "role": "assistant", "content": [{"type": "output_text", "text": "Done."}]},
            ]
        }
    )
    assert resumed_with_text == [{"role": "assistant", "content": "Done."}]
    response = chat_to_response(
        {
            "model": MODELS[0],
            "choices": [{"message": {"content": "Done", "reasoning_content": "Checked."}}],
            "usage": {
                "prompt_tokens": 3,
                "completion_tokens": 2,
                "total_tokens": 5,
                "prompt_cache_hit_tokens": 2,
                "prompt_cache_miss_tokens": 1,
            },
        },
        MODELS[0],
    )
    assert response["output_text"] == "Done"
    assert response["usage"]["input_tokens"] == 3
    assert response["usage"]["input_tokens_details"]["cached_tokens"] == 2
    assert response["output"][0]["type"] == "message"
    dsml_response = chat_to_response(
        {"choices": [{"message": {"content": dsml}}]}, MODELS[0]
    )
    assert dsml_response["output_text"] == ""
    assert dsml_response["output"][0]["type"] == "function_call"
    assert dsml_response["output"][0]["name"] == "exec_command"
    print("self-test passed")
    return 0


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Minimal Codex Responses proxy for DeepSeek.")
    parser.add_argument("--host", default=os.environ.get("DEEPSEEK_PROXY_HOST", DEFAULT_HOST))
    parser.add_argument("--port", type=int, default=int(os.environ.get("DEEPSEEK_PROXY_PORT", DEFAULT_PORT)))
    parser.add_argument("--upstream", default=os.environ.get("DEEPSEEK_BASE_URL", DEFAULT_UPSTREAM))
    parser.add_argument("--api-key-env", default="DEEPSEEK_API_KEY")
    parser.add_argument("--api-key-file", default=os.environ.get("DEEPSEEK_API_KEY_FILE", ""))
    parser.add_argument("--timeout", type=int, default=DEFAULT_TIMEOUT)
    parser.add_argument("--max-body-mb", type=int, default=128)
    parser.add_argument("--quiet", action="store_true")
    parser.add_argument("--status", action="store_true", help="Check whether the local proxy is already running.")
    parser.add_argument("--self-test", action="store_true")
    return parser.parse_args(argv)


def health_check(host: str, port: int) -> bool:
    try:
        with urllib.request.urlopen(f"http://{host}:{port}/health", timeout=2) as response:
            return response.status == 200
    except Exception:
        return False


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    if args.self_test:
        return self_test()
    if args.status:
        if health_check(args.host, args.port):
            print(f"running: http://{args.host}:{args.port}/v1")
            return 0
        print(f"not running: http://{args.host}:{args.port}/v1")
        return 1
    if health_check(args.host, args.port):
        print(f"deepseek-responses-proxy already running on http://{args.host}:{args.port}/v1")
        return 0
    if not os.environ.get(args.api_key_env) and not (
        args.api_key_file and read_key_file(args.api_key_file)
    ):
        key_source = args.api_key_env
        if args.api_key_file:
            key_source = f"{key_source} or {args.api_key_file}"
        print(f"error: {key_source} is not set", file=sys.stderr)
        return 2
    server = ThreadingHTTPServer((args.host, args.port), ProxyHandler)
    server.upstream = args.upstream
    server.api_key_env = args.api_key_env
    server.api_key_file = args.api_key_file
    server.timeout = args.timeout
    server.max_body_bytes = args.max_body_mb * 1024 * 1024
    server.quiet = args.quiet
    server.metrics = ProxyMetrics()
    # Retain thinking only until the matching tool output is translated. This
    # stays in memory and never reaches metrics, logs, or session files.
    server.reasoning_by_call_id: dict[str, str] = {}
    print(f"deepseek-responses-proxy listening on http://{args.host}:{args.port}/v1", flush=True)
    print(f"upstream: {args.upstream}/chat/completions", flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nshutting down", file=sys.stderr)
        return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
